# Meta Model API -- generate a key at https://dev.meta.ai
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
META_SAM_MODEL=sam-3.1

# Inference partners (open-weight protein models)
FIREWORKS_API_KEY=
BASETEN_API_KEY=

# Modal sandbox
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Provider switch: "mock" for offline development, "meta" for the live API
BIOCOMPILER_PROVIDER=mock
BIOCOMPILER_SIMULATOR=local
SIMULATION_TIMEOUT_SECONDS=30

# Optional HTTPS adapter: POST {"sequence": "..."}, response {"model": "esmfold-v1", "structure_pdb": "..."}
PROTEIN_ENDPOINT=
PROTEIN_API_KEY=
# Optional estimated cost; leave unset when unknown
# PROTEIN_COST_USD=0.01

# Next.js server proxy (set in apps/web/.env.local if using a different API address)
# BIOCOMPILER_API_URL=http://127.0.0.1:8000

# App
LOG_LEVEL=INFO
API_PORT=8000
